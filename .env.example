# Copy to .env in the project root, fill in real values, never commit it.
# Paste this file's contents into Portainer's stack "Environment variables"
# panel to deploy docker-compose.yml there.

# Docker Hub image to pull (built by .github/workflows/docker-publish.yml)
DOCKERHUB_USERNAME=
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Postgres container credentials — keep in sync with DATABASE_URL below
POSTGRES_DB=watchlist
POSTGRES_USER=watchlist
POSTGRES_PASSWORD=changeme

# Backend settings (watchlist/backend/app/config.py)
DATABASE_URL=postgresql+psycopg://watchlist:changeme@postgres:5432/watchlist
REDIS_URL=redis://redis:6379/0

OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,z-ai/glm-5.2:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
YAHOO_RPS=2
YAHOO_IMPERSONATE=chrome
BSE_ENABLED=true
REPLAY_DATE=
REFRESH_HOT_SECONDS=90
SCHEDULER_MARKET_HOURS_ONLY=true
ALLOWED_ORIGINS=http://localhost:3000
LLM_GLOBAL_DAILY_CAP=30
DEBUG=false
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

EMAIL_TRANSPORT=console
EMAIL_FROM=Smart Market Watchlist <watchlist@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_INTERVAL_SECONDS=300
NOTIFY_MIN_GAP_SECONDS=1800

GDELT_ENABLED=true
GOOGLE_NEWS_ENABLED=true
GOOGLE_API_KEY=

OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
